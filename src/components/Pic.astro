---
import { Picture, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  cover?: boolean;   // object-fit: cover (fills a slot)
  position?: string; // object-position
  eager?: boolean;
}
const { src, alt, width, height, sizes, cover = false, position, eager = false } = Astro.props;
const isPhoto = (src.width >= 800 || src.height >= 800);
---
{isPhoto && cover ? (
  <Picture src={src} alt={alt} formats={['avif', 'webp']}
    widths={[(width ?? src.width), Math.round((width ?? src.width) * 0.66), Math.round((width ?? src.width) * 0.42)]}
    sizes={sizes ?? '100vw'} loading={eager ? undefined : 'lazy'} class="cover-img">
    <img style={position ? `object-position:${position};` : ''} />
  </Picture>
) : (
  <Image src={src} alt={alt} width={width ?? src.width} height={height ?? src.height}
    loading={eager ? undefined : 'lazy'} style={cover ? `object-fit:cover;${position ? `object-position:${position};` : ''}` : (position ? `object-position:${position};` : '')} />
)}
