---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  cover?: boolean;   // object-fit: cover (fills a slot)
  position?: string; // object-position
  eager?: boolean;
}
const { src, alt, width, height, sizes, cover = false, position = '', eager = false } = Astro.props;
const w = width ?? src.width;
const style = `${cover ? `object-fit:cover;` : ``}${position ? `object-position:${position};` : ``}`;
---
<Picture src={src} alt={alt}
  formats={['avif', 'webp']}
  widths={cover ? [w, Math.round(w * 0.66), Math.round(w * 0.42)] : [w]}
  sizes={sizes ?? (cover ? '100vw' : undefined)}
  loading={eager ? undefined : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class={cover ? 'cover-img' : undefined}
  style={style || undefined} />
