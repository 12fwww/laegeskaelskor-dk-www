---
// <head> SEO block for every page of the mirror. Copy to src/components/SeoHead.astro
// and render it inside <head> in the layout.
//
// .env (committed, not secret):
//   PUBLIC_PRODUCTION_URL=https://customer.dk   the domain the site will live on
//   PUBLIC_PREVIEW=1                             1 while it is a preview on github.io
//
// While PUBLIC_PREVIEW=1 every page is noindex and every canonical points at the
// production domain, so the preview never competes with the customer's live site
// in Google. Launch = set PUBLIC_PREVIEW=0 and point the domain at the new host.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;               // 30–60 chars, unique, brand at the end: "Faconætsning af tyndplade | Etch"
  description: string;         // 110–160 chars, unique, says what the page answers
  path: string;                // the page's path on the production domain, e.g. "/vi-tilbyder/bladfjedre/"
  image?: ImageMetadata;       // a real photo from src/assets (1200px+ wide); default src/assets/og.jpg
  jsonld?: object[];           // schema.org objects for this page (Organization/LocalBusiness on home, BreadcrumbList inside)
  type?: 'website' | 'article';
}
const { title, description, path, image, jsonld = [], type = 'website' } = Astro.props;
const production = (import.meta.env.PUBLIC_PRODUCTION_URL || Astro.site?.origin || '').replace(/\/$/, '');
const preview = import.meta.env.PUBLIC_PREVIEW !== '0';
// Canonical always points at the production domain (even in preview) so the preview
// never competes with the customer's site in Google.
const canonical = production + path;
// Every page needs og:image (seo_check fails it otherwise): pages without a photo of their own
// share src/assets/og.jpg, the strongest photo of the site.
const fallback = Object.values(import.meta.glob<{ default: ImageMetadata }>('/src/assets/og.{jpg,jpeg,png,webp}', { eager: true }))[0]?.default;
const ogSource = image ?? fallback;
const og = ogSource ? await getImage({ src: ogSource, width: Math.min(1200, ogSource.width), format: 'jpg' }) : null;
const ogOrigin = import.meta.env.PUBLIC_ORIGIN || import.meta.env.PUBLIC_PRODUCTION_URL || Astro.site?.origin || 'https://localhost';
const ogUrl = og ? new URL(og.src.startsWith('/') ? og.src : `/${og.src}`, new URL(ogOrigin)).href : undefined;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{preview && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogUrl && <meta property="og:image" content={ogUrl} />}
{og && <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />}
<meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
{jsonld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
